{
  "buildCommand": "python manage.py collectstatic --noinput && python manage.py migrate",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/static/(.*)", "dest": "/api/index.py" },
    { "src": "/uploads/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
